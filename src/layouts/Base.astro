---
// Every page in the site goes through here, so noindex is set in exactly one
// place. This site publishes venue addresses and a family schedule.
import '../styles/tokens.css';
import '../styles/type.css';
import {
  OG_TITLE,
  OG_DESCRIPTION,
  OG_IMAGE,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
} from '../data/og';

interface Props {
  title: string;
  description?: string;
  /** Suppress the preview card on pages that must never be shareable. */
  noPreview?: boolean;
}

const { title, description, noPreview = false } = Astro.props;

// Absolute URLs — WhatsApp will not resolve a relative og:image.
const ogUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(OG_IMAGE, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Tints the browser chrome on Android to match the page. */}
    <meta name="theme-color" content="#FFF3E7" />

    {/* The two faces are 67KB of the page's ~73KB transfer. They are not
        render-blocking — font-display: swap means text paints immediately in
        the fallback — but preloading starts them during the CSS round trip
        instead of after it, which shortens the visible swap on Slow 4G. */}
    <link
      rel="preload"
      href="/fonts/playfair-display-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <script is:inline>
      // Content is visible by default. Scroll-reveal styles apply only when
      // this class is present, so a guest can never end up on a page whose
      // text is stuck at opacity 0 — the animation is an enhancement, never a
      // gate on reading the invitation. Runs before paint to avoid a flash.
      try {
        if (
          'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('js-anim');
        }
      } catch (e) {}
    </script>

    {
      /* Preview copy is identical on every link — see src/data/og.ts. Only
         og:url differs, because it is this page's own address. */
      !noPreview && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="#DilSeJAShANN" />
          <meta property="og:title" content={OG_TITLE} />
          <meta property="og:description" content={OG_DESCRIPTION} />
          <meta property="og:url" content={ogUrl} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
          <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
          <meta property="og:image:alt" content="#DilSeJAShANN" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={OG_TITLE} />
          <meta name="twitter:description" content={OG_DESCRIPTION} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--panel);
    color: var(--body);
  }

  /* Keyboard users could not previously see where they were. :focus-visible
     rather than :focus so a tap does not leave a ring behind on a phone. */
  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* Available to screen readers, invisible on screen. Used for headings that
     structure the page but would be redundant to show. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* A guest who prints the invitation should get the details, not the
     furniture. */
  @media print {
    a[href^='http']::after {
      content: ' (' attr(href) ')';
      font-size: 0.85em;
      word-break: break-all;
    }
    .no-print {
      display: none !important;
    }
  }
</style>

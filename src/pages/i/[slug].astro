---
// The invitation. One template for all seven links.
//
// TIER PRIVACY: getStaticPaths resolves each link's data at build time and
// passes only that link's slice as props. The full invites.json never reaches
// the browser. Nothing here may name a tier, an index, a side, or another
// link's functions — including the date range in the hero, which is derived
// from this link's own functions rather than the full 26–28 span.
import Base from '../../layouts/Base.astro';
import Arch from '../../components/Arch.astro';
import Monogram from '../../components/Monogram.astro';
import LiveBanner from '../../components/LiveBanner.astro';
import data from '../../data/invites.json';

export function getStaticPaths() {
  return data.invites.map((invite) => {
    const functions = invite.functions.map((id) => ({
      id,
      ...data.functions[id as keyof typeof data.functions],
    }));

    return {
      params: { slug: invite.slug },
      props: {
        couple: data.couple,
        venueNote: data.venueNote,
        giftNote: data.giftNote,
        functions,
        side: data.sides[invite.side as keyof typeof data.sides],
        accom: invite.accom,
      },
    };
  });
}

const { couple, venueNote, giftNote, functions, side, accom } = Astro.props;

// A function whose ceremonies each name their own venue has already answered
// "where do I go" — once per ceremony, with its own pin. Repeating the
// function's venue underneath and offering a third Get Directions button is a
// second answer to the same question, and on the Wedding it is the right answer
// for only one of the two buildings. Live mode had the same fault; see
// segments() in src/lib/live.ts.
const ownVenues = (f: any) =>
  Array.isArray(f.ceremonies) &&
  f.ceremonies.length > 0 &&
  f.ceremonies.every((c: any) => c.venue && c.mapsUrl);

const fmtFull = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

const fmtShort = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

// Derived from this link's functions only. A Wedding-only guest must not see
// a range implying anything happens on the 26th or the 28th.
const dates = [...new Set(functions.map((f) => f.date))].sort();
const first = dates[0];
const last = dates[dates.length - 1];
const year = first?.slice(0, 4);
const day = (iso: string) => String(Number(iso.slice(8, 10)));
const month = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });

// "27 December 2026" for one day, "26 – 28 December 2026" within a month.
const dateLine =
  dates.length === 1
    ? `${fmtShort(first)} ${year}`
    : month(first) === month(last)
      ? `${day(first)} – ${day(last)} ${month(last)} ${year}`
      : `${fmtShort(first)} – ${fmtShort(last)} ${year}`;

// Only invitations including the Wedding may link to the ceremony explainers.
const showCeremonies = functions.some((f) => f.id === 'f2');

// dressColors accepts "#RRGGBB" or { name, hex }. Both are rendered as a
// swatch; a name is shown beside it when given.
type Swatch = { hex: string; name?: string };
const swatches = (raw: unknown[]): Swatch[] =>
  raw.map((c) =>
    typeof c === 'string' ? { hex: c } : (c as Swatch)
  );
---

<Base title="#DilSeJAShANN" framed>
  <div class="page">
    {/* Pinned above everything during the wedding days. Hidden otherwise. */}
    <LiveBanner functions={functions} contact={side.contacts[0]} />

    <header class="hero" id="hero">
      <p class="wordmark">#DilSeJAShANN</p>

      <div class="hero-arch">
        <Arch />
        <div class="hero-inner">
          {/* Mirrors page 1 of the printed cards: the mark inside the arch,
              above the names. eager because it sits above the fold. */}
          <Monogram size="lg" eager class="hero-mark" />
          {/* The names are the page's heading. Previously the document started
              at h2, which leaves a screen reader with no title for the page. */}
          <h1 class="couple">{couple}</h1>
          <p class="hero-dates">{dateLine}</p>
          {/* Counts to THIS link's first function, in IST. Filled client-side
              because a static build would bake in the day it was deployed. */}
          <p class="countdown" id="countdown" data-first={dates[0]} hidden></p>
        </div>
      </div>

      <p class="greeting">{side.greeting}</p>

      <a class="cta" href="rsvp">RSVP</a>
    </header>

    <main>
      {
        functions.map((f) => (
          <section class="fn reveal">
            <h2>{f.name}</h2>
            <p class="fn-date">{fmtFull(f.date)}</p>

            {'ceremonies' in f && Array.isArray(f.ceremonies) ? (
              /* Two ceremonies in one function. A guest who reads only one
                 start time arrives at the wrong hour. */
              <ul class="times">
                {f.ceremonies.map((c: any) => (
                  <li>
                    <div class="ceremony-head">
                      <span class="ceremony">{c.name}</span>
                      <span class="time">{c.startTime}</span>
                    </div>
                    {/* The two ceremonies can be at different venues. A guest
                        arriving for the first needs that pin, not the one for
                        where the day ends up. */}
                    {c.venue && (
                      <div class="ceremony-where">
                        <span class="ceremony-venue">{c.venue}</span>
                        {c.mapsUrl && (
                          <a
                            class="ceremony-map"
                            href={c.mapsUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            Directions
                          </a>
                        )}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="time solo">{(f as { startTime: string }).startTime}</p>
            )}

            {ownVenues(f) ? (
              /* The rows above carry the venues. What is left to say is the
                 street address, which both buildings share — they are next
                 door to each other. */
              <p class="address address-shared">{f.address}</p>
            ) : (
              <div class="venue">
                <p class="venue-name">{f.venue}</p>
                <p class="address">{f.address}</p>
              </div>
            )}

            <div class="actions">
              {!ownVenues(f) && (
                <a class="btn" href={f.mapsUrl} target="_blank" rel="noopener noreferrer">
                  Get Directions
                </a>
              )}
              <a class="btn quiet" href={`${f.id}.ics`} download>
                Add to Calendar
              </a>
              {/* Guests paste this into a cab app, which a Maps link cannot
                  serve. Hidden when the browser has no clipboard access. The
                  venue name is left out when the ceremonies sit at different
                  ones — naming just the last would be worse than naming none. */}
              <button
                type="button"
                class="btn quiet copy-address no-print"
                data-copy={ownVenues(f) ? f.address : `${f.venue}, ${f.address}`}
                hidden
              >
                Copy address
              </button>
            </div>

            <div class="dress">
              <p class="dress-code">{f.dressCode}</p>
              {swatches(f.dressColors).length > 0 && (
                <ul class="swatches">
                  {swatches(f.dressColors).map((c) => (
                    <li>
                      <span class="chip" style={`background:${c.hex}`} />
                      {c.name && <span class="chip-name">{c.name}</span>}
                    </li>
                  ))}
                </ul>
              )}
              {f.dressNote && <p class="dress-note">{f.dressNote}</p>}
            </div>
          </section>
        ))
      }

      {
        functions.length > 1 && (
          <section class="fn reveal">
            <h2>All of it, in one go</h2>
            <p class="lead">
              Put every date in your calendar at once, rather than one at a time.
            </p>
            <div class="actions">
              <a class="btn quiet" href="all.ics" download>
                Add all to Calendar
              </a>
            </div>
          </section>
        )
      }

      {
        showCeremonies && (
          <section class="fn reveal">
            <h2>The ceremonies</h2>
            <p class="lead">
              A short guide to what happens on the day, and what to expect.
            </p>
            <div class="actions">
              <a class="btn" href="/ceremonies">
                Read the guide
              </a>
            </div>
          </section>
        )
      }

      {
        accom && (
          <section class="fn reveal">
            <h2>Staying with us</h2>
            {/* The hotel is not fixed yet. Until it is, the block is the note
                alone — an empty venue line and a Get Directions button pointing
                at nothing is worse than saying plainly that details will
                follow. Filling in mapsUrl brings the venue back. */}
            {side.hotel.mapsUrl && (
              <>
                <div class="venue">
                  <p class="venue-name">{side.hotel.name}</p>
                  <p class="address">{side.hotel.address}</p>
                </div>
                <div class="actions">
                  <a class="btn" href={side.hotel.mapsUrl} target="_blank" rel="noopener noreferrer">
                    Get Directions
                  </a>
                </div>
              </>
            )}
            <p class="note">{side.hotel.note}</p>
          </section>
        )
      }

      {/* One practical line, not an airport-and-station guide. Nearly everyone
          invited is local to Gurgaon or Delhi and does not need telling which
          airport; what they cannot know is the parking. Shared across both
          sides deliberately — it describes the venue, not the family. */}
      <section class="fn reveal">
        <h2>Getting here</h2>
        <p class="lead">{venueNote}</p>
      </section>

      <section class="fn reveal">
        <h2>Any questions</h2>
        <ul class="contacts">
          {
            side.contacts.map((c) => (
              <li>
                <span class="contact-name">{c.name}</span>
                <a class="btn quiet" href={`tel:${c.phone.replace(/\s+/g, '')}`}>
                  {c.phone}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* "No boxed gifts" is the recognised idiom at an Indian wedding and is
          left to stand on its own — Jaskaran's call, 2026-09-05. Deliberately
          low on the page: a guest has had two chances to RSVP before reaching
          it. */}
      <section class="fn solo reveal">
        <h2>{giftNote}</h2>
      </section>

      {/* Shared by all seven links and function-neutral, so it is safe to link
          from every invitation without a gate. */}
      <section class="fn reveal">
        <h2>Our story</h2>
        <p class="lead">A little about how the two of them got here.</p>
        <div class="actions">
          <a class="btn quiet" href="/story">Read our story</a>
          <a class="btn quiet" href="/photos">Photographs</a>
        </div>
      </section>

      {/* No arch here — it is hero-only, deliberately. Everything else stays
          quiet. See docs/DECISIONS.md. */}
      <section class="closing reveal">
        <Monogram size="xs" class="closing-mark" />
        <p class="closing-line">We would love to have you there.</p>
        <a class="cta" href="rsvp">RSVP</a>
      </section>
    </main>
  </div>
</Base>

<script>
  import { fakedNow, daysUntil } from '../../lib/time.ts';

  // The signature moment runs once per session. Internal navigation must not
  // replay it, and neither should a guest re-opening the link from WhatsApp.
  const hero = document.getElementById('hero');
  const KEY = 'dilsejashann-arch-seen';
  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
  } catch (e) {}

  if (hero && !seen) {
    hero.classList.add('arch-draw', 'settle');
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (e) {}
  }

  // Countdown to this link's own first function. A Reception-only guest counts
  // to the 28th, never the 26th — the same rule as the hero date line.
  //
  // Computed once on load rather than on a timer: a day-level count does not
  // need one, and a ticking interval costs battery and can jank on a low-end
  // phone for no gain.
  const cd = document.getElementById('countdown');
  if (cd && cd.dataset.first) {
    // Same ?now= override as live mode, so both can be checked on a real phone
    // before the day. The date maths lives in src/lib/time.ts alongside live
    // mode's, so the two cannot disagree about when a day begins.
    const base = fakedNow(new URLSearchParams(location.search).get('now')) ?? Date.now();
    const days = daysUntil(cd.dataset.first, base);
    if (days > 0) {
      cd.textContent = days === 1 ? 'Tomorrow' : `${days} days to go`;
      cd.hidden = false;
    }
    // Zero or negative means the day has arrived or passed, and live mode owns
    // the page from that point.
  }

  // Copy address — revealed only when the browser can actually do it.
  const copyBtns = document.querySelectorAll<HTMLButtonElement>('.copy-address');
  if (navigator.clipboard && window.isSecureContext) {
    copyBtns.forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', async () => {
        const was = b.textContent;
        try {
          await navigator.clipboard.writeText(b.dataset.copy || '');
          b.textContent = 'Copied';
        } catch (e) {
          b.textContent = 'Press and hold to copy';
        }
        setTimeout(() => {
          b.textContent = was;
        }, 1600);
      });
    });
  }

  // Scroll reveals via IntersectionObserver — never a scroll listener, never
  // an rAF loop reading scroll position.
  //
  // A fast or programmatic scroll can carry a section from below the viewport
  // to above it inside one frame. Its intersection state never becomes true, so
  // a naive per-entry handler leaves it at opacity 0 permanently — a guest can
  // scroll past the contact numbers and never see them. Every callback
  // therefore sweeps all pending elements rather than trusting the entries,
  // and a sweep also runs on load and on restore from the back/forward cache.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

  if (reduced || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('shown'));
  } else {
    const pending = new Set(items);

    const show = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.classList.add('shown');
      // will-change only on elements actively animating; removed after.
      el.style.willChange = 'transform, opacity';
      el.addEventListener(
        'transitionend',
        () => {
          el.style.willChange = '';
        },
        { once: true }
      );
      io.unobserve(el);
    };

    const sweep = () => {
      pending.forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight * 0.92) show(el);
      });
    };

    const io = new IntersectionObserver(sweep, {
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.05,
    });

    items.forEach((el) => io.observe(el));
    requestAnimationFrame(sweep);
    window.addEventListener('pageshow', sweep);

    // Hard failsafe. If the observer never fires — and in testing it can stay
    // completely silent — everything still becomes visible shortly after load.
    // Revealing an element that is still off-screen costs nothing visually,
    // so this can never be seen by a guest reading normally.
    setTimeout(() => {
      pending.forEach((el) => {
        el.classList.add('shown');
        io.unobserve(el);
      });
      pending.clear();
    }, 2500);
  }
</script>

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gap) var(--gap-xl);
  }

  /* ---------- hero ---------- */
  .hero {
    text-align: center;
    padding-top: var(--gap-lg);
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-md);
    color: var(--ink);
    margin: 0 0 var(--gap-lg);
    letter-spacing: 0.01em;
  }
  .hero-arch {
    position: relative;
    max-width: 19rem;
    margin: 0 auto;
  }
  .hero-inner {
    position: absolute;
    left: 50%;
    top: 56%;
    transform: translate(-50%, -50%);
    /* Kept clear of the arch legs so a longer pair of names wraps rather than
       colliding with the stroke. */
    width: 74%;
  }
  h1.couple {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-xl);
    line-height: 1.08;
    color: var(--ink);
    margin: 0;
  }
  .hero-dates {
    font-family: var(--sans);
    font-size: var(--t-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--body);
    opacity: 0.75;
    margin: var(--gap-sm) 0 0;
  }
  .countdown {
    font-family: var(--sans);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: var(--gap-xs) 0 0;
  }
  .greeting {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.65;
    color: var(--body);
    margin: var(--gap-lg) auto var(--gap);
    max-width: 30rem;
  }

  /* Content settles inside the arch after it strokes in. Transform and
     opacity only. */
  .settle .couple,
  .settle .hero-dates,
  .settle .greeting,
  .settle > .cta {
    animation: settle 620ms cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
  }
  .settle .couple {
    animation-delay: 620ms;
  }
  .settle .hero-dates {
    animation-delay: 730ms;
  }
  .settle .greeting {
    animation-delay: 830ms;
  }
  .settle > .cta {
    animation-delay: 920ms;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Collapse to the instant state. The arch carries its own guard, and the
     scroll reveals never hide anything unless the head script has already
     confirmed reduced motion is off — this is the remaining case. */
  @media (prefers-reduced-motion: reduce) {
    .settle .couple,
    .settle .hero-dates,
    .settle .greeting,
    .settle > .cta {
      animation: none;
    }
  }

  /* ---------- calls to action ---------- */
  .cta {
    /* inline-flex, not inline-block. min-height applies to the CONTENT box, so
       an inline-block pill got a 48px-tall content box with the single line of
       text sitting at the TOP of it — the word rode 12.3px high inside a 78px
       pill. .btn never had the fault because it was already inline-flex with
       align-items: center. Measured, not guessed. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-base);
    letter-spacing: 0.1em;
    /* letter-spacing adds a trailing space after the final letter, which drags
       the glyphs half a space left of true centre. This cancels it. */
    text-indent: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.95rem 3rem;
    min-height: 48px;
    /* Maroon fill, cream text. The brand gold fails AA as a fill — 2.49:1 on
       cream. See docs/DECISIONS.md. */
    background: var(--accent);
    color: var(--panel);
    border-radius: 999px;
    margin-top: var(--gap-sm);
  }

  /* ---------- function cards ---------- */
  .fn,
  .closing {
    margin-top: var(--gap-xl);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--line);
  }
  /* Hidden ONLY when the head script has confirmed we can reveal again.
     Without js-anim these rules never apply and everything is simply visible. */
  :global(html.js-anim) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 520ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :global(html.js-anim) .reveal.shown {
    opacity: 1;
    transform: none;
  }

  h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-lg);
    color: var(--ink);
    margin: 0;
    line-height: 1.15;
  }
  .fn-date {
    font-family: var(--sans);
    font-size: var(--t-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--body);
    opacity: 0.7;
    margin: var(--gap-xs) 0 var(--gap);
  }

  .times {
    list-style: none;
    margin: 0 0 var(--gap);
    padding: 0;
  }
  .times li {
    padding: 0.6rem 0;
    border-bottom: 1px dotted var(--line);
  }
  .ceremony-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap);
  }
  .ceremony-where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-sm);
    margin-top: 0.2rem;
  }
  .ceremony-venue {
    font-family: var(--sans);
    font-size: var(--t-sm);
    color: var(--body);
    opacity: 0.85;
  }
  .ceremony-map {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    /* A real tap target, not an 18px line of text. This is the only route to a
       venue on a function whose ceremonies each have their own — see
       ownVenues() above. Stays a link rather than becoming a third button
       style; only the hit area grows. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.2rem;
  }
  .ceremony {
    font-family: var(--display);
    font-size: var(--t-base);
    color: var(--ink);
  }
  .time {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-base);
    color: var(--body);
    font-variant-numeric: tabular-nums;
  }
  .time.solo {
    margin: 0 0 var(--gap);
  }

  .venue-name {
    font-family: var(--display);
    font-size: var(--t-md);
    color: var(--ink);
    margin: 0 0 var(--gap-xs);
  }
  .address,
  .note,
  .lead {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--body);
    margin: 0;
  }
  .note,
  .lead {
    margin-top: var(--gap-sm);
  }

  .address-shared {
    margin-top: var(--gap-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin: var(--gap) 0;
  }
  .btn {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-sm);
    text-decoration: none;
    padding: 0.7rem 1.1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--panel);
  }
  .btn.quiet {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .dress {
    margin-top: var(--gap);
  }
  .dress-code {
    font-family: var(--sans);
    font-size: var(--t-base);
    color: var(--body);
    margin: 0;
  }
  .swatches {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    margin: var(--gap-sm) 0 0;
    padding: 0;
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }
  .chip {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: inline-block;
  }
  .chip-name {
    font-family: var(--sans);

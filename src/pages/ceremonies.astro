---
// Ceremony explainers for the Wedding day.
//
// TIER GATE: this page describes f2 only. It is linked ONLY from invitations
// whose functions array contains f2 — the conditional lives in
// src/pages/i/[slug].astro and is driven off functions.includes('f2'), never
// off tier or side. Reception-only guests are not invited to the Wedding and
// must not meet this content.
//
// The page itself is unlisted rather than access-controlled: a Reception-only
// guest who is sent the URL directly could open it. That is accepted — nothing
// here names a tier, a side, or any other function, so it reads as general
// background about the day rather than as evidence of a tier they are missing.
//
// ONE SOURCE OF TRUTH: the printed A6 cards and this page carry the same words.
// The cards print first and cannot be recalled, so the site matches the card.
// If a correction is needed after printing, the card is re-issued rather than
// this page quietly diverging.
//
// NOT YET CONFIRMED: the ritual sequences are awaiting family elders — in
// particular the card title "Vivaah", whether it runs four pheras or seven, and
// whether the gurdwara adds anything. Structure only until that lands.
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import data from '../data/ceremonies.json';

const { intro, ceremonies } = data;
---

<Base title="The ceremonies — #DilSeJAShANN" framed>
  <div class="page">
    <header>
      <p class="wordmark">#DilSeJAShANN</p>
      <Monogram size="sm" eager />
      <h1>The ceremonies</h1>
      <p class="intro">{intro}</p>
    </header>

    {
      ceremonies.map((c) => (
        <article class="ceremony">
          {/* Four panels, which is exactly the printed card's four pages: the
              cover, what is happening plus the etiquette, the order, and the
              meaning. Swiped rather than flipped — the gesture without rotateY,
              which is the jankiest thing on an old Android. Everything is in
              the DOM at all times, so find-in-page and a screen reader are
              unaffected; someone may be reading this at the Gurudwara on bad
              data and must not have to interact to reach the words. */}
          <div
            class="pages"
            tabindex="0"
            role="region"
            aria-label={`${c.name} — swipe or use the arrow keys`}
          >
            <section class="panel panel-cover">
              {/* Page 1 of the printed card: the mark, the tradition, the name,
                  the gloss. Name and gloss alone left 700px of empty cream. */}
              <Monogram size="sm" class="cover-mark" />
              <p class="tradition">{c.tradition}</p>
              <h2>{c.name}</h2>
              <p class="gloss">{c.gloss}</p>
            </section>

            <section class="panel">
              <h3>What is happening</h3>
              {c.about.map((p) => (
                <p class="about">{p}</p>
              ))}
              <h4 class="sub">Before you come</h4>
              <dl class="etiquette">
                {c.etiquette.map((e) => (
                  <>
                    <dt>{e.title}</dt>
                    <dd>{e.note}</dd>
                  </>
                ))}
              </dl>
            </section>

            <section class="panel">
              <h3>What happens, in order</h3>
              <ol class="steps">
                {c.sequence.map((s) => (
                  <li class="step">
                    <span class="step-name">{s.name}</span>
                    <span class="step-note">{s.note}</span>
                  </li>
                ))}
              </ol>
            </section>

            <section class="panel">
              <h3>{c.meaning.title}</h3>
              {/* The card sets this block between a lead and a closing line —
                  "Composed by Guru Ram Das…" and "When the fourth Laav ends,
                  they are married." The cards print first and cannot be
                  recalled, so the site carries the same words. */}
              {c.meaning.lead && <p class="meaning-lead">{c.meaning.lead}</p>}
              <ol class="steps meaning">
                {c.meaning.items.map((s) => (
                  <li class="step">
                    <span class="step-name">{s.name}</span>
                    <span class="step-note">{s.note}</span>
                  </li>
                ))}
              </ol>
              {c.meaning.closing && <p class="meaning-closing">{c.meaning.closing}</p>}
            </section>
          </div>

          {/* Filled in by script. Without JS the scroller still works by drag
              and every word is present, so these are enhancement, not plumbing. */}
          <div class="pager no-print" hidden>
            <button type="button" class="pager-arrow" data-dir="-1" aria-label="Previous page">‹</button>
            <div class="dots" aria-hidden="true" />
            <button type="button" class="pager-arrow" data-dir="1" aria-label="Next page">›</button>
          </div>
        </article>
      ))
    }
  </div>
</Base>

<script>
  // Two jobs: wire the pager, and reveal each panel's steps when that panel is
  // the one being looked at.
  //
  // THE REVEAL USED TO TEST VERTICAL POSITION. Inside a horizontal scroller
  // every panel is vertically on screen at load, so the old check passed for all
  // of them and the whole stagger fired at once into panels nobody was looking
  // at. It observes panels now, not steps.
  //
  // The hardening is unchanged and matters more here, not less: steps are
  // visible unless the head script has confirmed they can be revealed, every
  // callback sweeps rather than trusting entries, and a timeout catches anything
  // the observer misses. Nobody may lose the ceremony order to a stalled
  // animation.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrollers = Array.from(document.querySelectorAll<HTMLElement>('.pages'));
  const allSteps = Array.from(document.querySelectorAll<HTMLElement>('.step'));

  if (reduced || !('IntersectionObserver' in window)) {
    allSteps.forEach((el) => el.classList.add('shown'));
  }

  for (const scroller of scrollers) {
    const panels = Array.from(scroller.querySelectorAll<HTMLElement>('.panel'));
    const article = scroller.closest('article')!;
    const pager = article.querySelector<HTMLElement>('.pager');
    const dotWrap = pager?.querySelector<HTMLElement>('.dots');
    const arrows = Array.from(pager?.querySelectorAll<HTMLButtonElement>('.pager-arrow') ?? []);

    // --- reveal, per panel ---------------------------------------------------
    const revealPanel = (panel: HTMLElement) => {
      const steps = Array.from(panel.querySelectorAll<HTMLElement>('.step'));
      steps.forEach((el, i) => {
        if (el.classList.contains('shown')) return;
        el.style.transitionDelay = `${Math.min(i, 5) * 70}ms`;
        el.classList.add('shown');
        el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
      });
    };

    if (!reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          // Sweep, do not trust the entries: a fast swipe can carry a panel
          // through the observed band inside one frame.
          for (const panel of panels) {
            const b = panel.getBoundingClientRect();
            if (b.left < window.innerWidth * 0.9 && b.right > 0) revealPanel(panel);
          }
        },
        { root: scroller, threshold: 0.15 }
      );
      panels.forEach((el) => io.observe(el));
      // Whatever the observer missed, show anyway. Content beats choreography.
      setTimeout(() => panels.forEach(revealPanel), 4000);
    }

    // --- pager ---------------------------------------------------------------
    if (!pager || !dotWrap || panels.length < 2) continue;

    panels.forEach(() => {
      const d = document.createElement('span');
      d.className = 'dot';
      dotWrap.appendChild(d);
    });
    const dots = Array.from(dotWrap.children) as HTMLElement[];
    pager.hidden = false;

    const current = () => Math.round(scroller.scrollLeft / (scroller.clientWidth + 20));

    const sync = () => {
      const i = Math.max(0, Math.min(panels.length - 1, current()));
      dots.forEach((d, n) => d.classList.toggle('on', n === i));
      arrows.forEach((a) => {
        const dir = Number(a.dataset.dir);
        a.disabled = dir < 0 ? i === 0 : i === panels.length - 1;
      });
    };

    const go = (dir: number) => {
      const i = Math.max(0, Math.min(panels.length - 1, current() + dir));
      panels[i].scrollIntoView({
        behavior: reduced ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    };

    arrows.forEach((a) => a.addEventListener('click', () => go(Number(a.dataset.dir))));
    scroller.addEventListener('scroll', sync, { passive: true });
    scroller.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });
    sync();
  }
</script>

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--gap-lg) var(--gap) var(--gap-xl);
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-md);
    color: var(--ink);
    margin: 0 0 var(--gap-lg);
    text-align: center;
  }
  h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-xl);
    color: var(--ink);
    margin: 0;
    text-align: center;
  }
  .intro {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.65;
    color: var(--body);
    margin: var(--gap) auto 0;
    text-align: center;
    max-width: 30rem;
  }

  .ceremony {
    margin-top: var(--gap-xl);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--line);
  }
  h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-lg);
    color: var(--ink);
    margin: 0;
  }
  .gloss {
    font-family: var(--sans);
    font-size: var(--t-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--body);
    opacity: 0.7;
    margin: var(--gap-xs) 0 var(--gap);
  }
  .about {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--body);
    margin: 0 0 var(--gap-sm);
  }

  h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--gap-sm);
  }

  /* ---------- the book ----------
     Scroll-snap does the work. No JavaScript is required for it to function,
     which matters on a page someone may be reading at the Gurudwara on bad
     data. The panel headings keep the existing h3 label style. */
  .pages {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Without this a swipe past the last panel triggers iOS back-navigation
       and drops the guest out of the page entirely. */
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    gap: var(--gap);
    margin-inline: calc(var(--gap) * -1);
    padding-inline: var(--gap);
  }
  .pages::-webkit-scrollbar {
    display: none;
  }
  .pages:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .panel {
    flex: 0 0 100%;
    scroll-snap-align: center;
    min-width: 0;
    /* One panel of eight is taller than a phone screen — Vivaah's eight-step
       order. It scrolls inside itself rather than shrinking type on a page
       whose whole job is being read. */
    max-height: 78vh;
    overflow-y: auto;
    padding: var(--gap-lg) var(--gap);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .cover-mark {
    margin-bottom: var(--gap-lg);
  }
  .tradition {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--line);
    margin: 0 0 var(--gap-sm);
  }
  .panel-cover h2 {
    font-size: var(--t-xl);
  }
  .panel-cover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .sub {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: var(--gap-lg) 0 var(--gap-sm);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .pager-arrow {
    font-family: var(--sans);
    font-size: var(--t-lg);
    line-height: 1;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }
  .pager-arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  .dots {
    display: flex;
    gap: var(--gap-xs);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
    opacity: 0.35;
  }
  .dot.on {
    opacity: 1;
    background: var(--ink);
  }

  /* On paper a horizontal scroller is one page and three invisible ones. */
  @media print {
    .pages {
      display: block;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    .panel {
      max-height: none;
      overflow: visible;
      border: 0;
      padding-inline: 0;
      break-inside: avoid;
    }
  }

  .etiquette {
    margin: 0;
  }
  .etiquette dt {
    font-family: var(--display);
    font-size: var(--t-base);
    color: var(--ink);
    margin-top: var(--gap-sm);
  }
  .etiquette dd {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--body);
    margin: 0.15rem 0 0;
  }


  /* ---------- desktop ----------
     Prose wants a narrow measure, so this page does NOT take the invitation's
     wide two-column treatment. It gets the surround from Base.astro and enough
     padding to read as a card rather than a strip; the text stays at roughly
     --measure. */
  @media (min-width: 60rem) {
    .page {
      max-width: 44rem;
      padding: var(--gap-xl);
    }
  }

  .meaning-lead {
    font-family: var(--sans);
    font-size: var(--t-sm);
    font-style: italic;
    line-height: 1.6;
    color: var(--body);
    opacity: 0.85;
    margin: 0 0 var(--gap);
  }
  .meaning-closing {
    font-family: var(--display);
    font-size: var(--t-base);
    font-style: italic;
    color: var(--ink);
    margin: var(--gap) 0 0;
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  .step {
    counter-increment: step;
    position: relative;
    padding: 0 0 var(--gap) 2.5rem;
    border-left: 1px solid var(--line);
    margin-left: 0.6rem;
  }
  .step:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .step::before {
    content: counter(step);
    position: absolute;
    left: -0.75rem;
    top: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--sans);
    font-size: var(--t-xs);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-name {
    display: block;
    font-family: var(--display);
    font-size: var(--t-base);
    color: var(--ink);
  }
  .step-note {
    display: block;
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--body);
    margin-top: 0.15rem;
  }

  /* Hidden only once the head script confirms the reveal can happen. */
  :global(html.js-anim) .step {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 460ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 460ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :global(html.js-anim) .step.shown {
    opacity: 1;
    transform: none;
  }
</style>

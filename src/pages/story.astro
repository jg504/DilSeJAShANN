---
// The shared story. Reachable from all seven invitations.
//
// FUNCTION-NEUTRAL THROUGHOUT. Because every link reaches this page, nothing
// here may name a function, a date, or a side. No caption referencing an event
// only some guests are invited to, and no closing line about the 28th — two of
// the seven invitations end a day before everyone else.
//
// The copy lives in src/data/story.json and is validated like the rest, so a
// half-written story cannot ship.
//
// Class B: no meaningful weight cap once photographs arrive. They belong in
// src/assets/ so Astro processes them, never in public/.
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import Ornament from '../components/Ornament.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Photographs live in src/assets/story/ so Astro processes them at build time.
// Anything in public/ would ship at full size — a 4MB phone photo straight onto
// a guest's mobile data. The glob is eager because the filenames come from JSON
// and have to be resolved at build, not runtime.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/story/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const photo = (src: string) => files[`../assets/story/${src}`]?.default;
import story from '../data/story.json';
---

<Base title="Our story — #DilSeJAShANN" framed>
  <div class="page">
    <header>
      <p class="wordmark">#DilSeJAShANN</p>
      <Monogram size="sm" eager />
      <h1>{story.title}</h1>
      <p class="intro">{story.intro}</p>
    </header>

    {/* The one image above the fold, so the only one loaded eagerly. */}
    {story.lead && photo(story.lead.src) && (
      <figure class="shot lead-shot">
        <Picture
          src={photo(story.lead.src)!}
          formats={['avif', 'webp']}
          widths={[400, 800, 1200, 1600]}
          width={1600}
          sizes="(min-width: 60rem) 36rem, 100vw"
          alt={story.lead.alt}
          loading="eager"
          decoding="sync"
        />
        {story.lead.caption && <figcaption>{story.lead.caption}</figcaption>}
      </figure>
    )}

    {
      story.chapters.map((c) => (
        <section class="chapter reveal">
          <span class="ch-mark"><Ornament kind="rosette" /></span>
          <h2>{c.heading}</h2>

          {/* Rule, heading, photo, text. The photo belongs to its own chapter
              rather than floating between two, and the words explain what you
              have just looked at. All lazy — none of these is above the fold. */}
          {(c.images ?? []).map((img: any) =>
            photo(img.src) ? (
              <figure class="shot">
                <Picture
                  src={photo(img.src)!}
                  formats={['avif', 'webp']}
                  widths={[400, 800, 1200, 1600]}
                  width={1600}
                  sizes="(min-width: 60rem) 36rem, 100vw"
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ) : null
          )}

          {c.body.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }

    <p class="closing reveal">{story.closing}</p>
  </div>
</Base>

<script>
  // Same hardening as elsewhere: content is visible unless the head script has
  // confirmed the reveal can run, every callback sweeps all pending elements,
  // and a timeout catches anything the observer misses.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

  if (reduced || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('shown'));
  } else {
    const pending = new Set(items);
    const show = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.classList.add('shown');
      io.unobserve(el);
    };
    const sweep = () => {
      pending.forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight * 0.92) show(el);
      });
    };
    const io = new IntersectionObserver(sweep, { threshold: 0.05, rootMargin: '0px 0px -8% 0px' });
    items.forEach((el) => io.observe(el));
    requestAnimationFrame(sweep);
    window.addEventListener('pageshow', sweep);
    setTimeout(() => {
      pending.forEach((el) => {
        el.classList.add('shown');
        io.unobserve(el);
      });
      pending.clear();
    }, 2500);
  }
</script>

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--gap-lg) var(--gap) var(--gap-xl);
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-md);
    color: var(--ink);
    margin: 0 0 var(--gap-lg);
    text-align: center;
  }
  h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-xl);
    color: var(--ink);
    margin: 0;
    text-align: center;
    line-height: 1.1;
  }
  .intro {
    font-family: var(--sans);
    font-size: var(--t-md);
    line-height: 1.6;
    color: var(--body);
    margin: var(--gap) auto 0;
    text-align: center;
    max-width: 30rem;
  }
  .ch-mark {
    display: block;
    margin: 0 0 var(--gap-sm);
  }

  .chapter {
    margin-top: var(--gap-xl);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--line);
  }
  h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-lg);
    color: var(--ink);
    margin: 0 0 var(--gap-sm);
  }
  .chapter p {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.75;
    color: var(--body);
    margin: 0 0 var(--gap-sm);
  }

  .shot {
    margin: 0 0 var(--gap);
    /* A warm ground so a photograph that has not arrived yet is a block of the
       page's own colour rather than a white hole. No blur or dominant-colour
       placeholder: CLAUDE.md asks for those in galleries, and this is a story,
       not a gallery. */
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .lead-shot {
    margin-top: var(--gap-xl);
  }
  /* Picture emits intrinsic width and height, so height:auto keeps the aspect
     ratio and reserves the space before the bytes land. This one line is the
     difference between a page that settles and a page that jumps. */
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    font-family: var(--sans);
    font-size: var(--t-sm);
    font-style: italic;
    line-height: 1.5;
    color: var(--body);
    opacity: 0.8;
    padding: var(--gap-sm) var(--gap-sm) var(--gap);
  }

  /* ---------- desktop ----------
     Prose wants a narrow measure, so this page does NOT take the invitation's
     wide two-column treatment. It gets the surround from Base.astro and enough
     padding to read as a card rather than a strip; the text stays at roughly
     --measure. */
  @media (min-width: 60rem) {
    .page {
      max-width: 44rem;
      padding: var(--gap-xl);
    }
  }

  .closing {
    font-family: var(--display);
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink);
    text-align: center;
    margin: var(--gap-xl) auto 0;
    max-width: 28rem;
  }

  :global(html.js-anim) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 520ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :global(html.js-anim) .reveal.shown {
    opacity: 1;
    transform: none;
  }
</style>

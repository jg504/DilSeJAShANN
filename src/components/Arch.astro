---
// The arch — the site's signature element, carried from the card.
//
// HERO ONLY. It does not appear on function cards or around the RSVP button;
// everything else stays quiet. Scattered motion is what makes a designed page
// read as templated. See docs/DECISIONS.md.
//
// On load the stroke draws itself in, then the content inside settles.
// stroke-dashoffset is a paint-only property on SVG — it does not trigger
// layout, so it does not violate the transform/opacity rule, and the brief
// explicitly asks for the arch to stroke itself in.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['arch', className]}
  viewBox="0 0 360 352"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="arch-outer"
    d="M6 346 L6 186 A174 174 0 0 1 354 186 L354 346"
    stroke="var(--line)"
    stroke-width="2.5"
    stroke-linecap="round"
  />
  <path
    class="arch-inner"
    d="M24 346 L24 186 A156 156 0 0 1 336 186 L336 346"
    stroke="var(--line)"
    stroke-width="1"
    opacity="0.4"
  />
</svg>

<style>
  .arch {
    display: block;
    width: 100%;
    height: auto;
  }

  .arch-outer,
  .arch-inner {
    /* Generously longer than the real path length, so one value covers both
       and no measurement is needed at runtime. */
    stroke-dasharray: 1400;
    stroke-dashoffset: 0;
  }

  /* The animation is added by the hero only on the first view of a session. */
  :global(.arch-draw) .arch-outer,
  :global(.arch-draw) .arch-inner {
    stroke-dashoffset: 1400;
    animation: arch-draw 900ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  :global(.arch-draw) .arch-inner {
    animation-delay: 120ms;
  }

  @keyframes arch-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.arch-draw) .arch-outer,
    :global(.arch-draw) .arch-inner {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>

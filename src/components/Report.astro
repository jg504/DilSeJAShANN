---
// Read-only RSVP dashboard. No writes, ever.
//
// The arithmetic lives in src/lib/report.ts and is covered by scripts/
// test-report.mjs — this file only fetches and renders. Keeping the maths out
// of an inline script is the whole point: bed-nights decide how many beds get
// booked, so that logic is tested rather than eyeballed in a dashboard.
import invites from '../data/invites.json';

interface Props {
  which: 'groom' | 'bride' | 'both';
}
const { which } = Astro.props;

// Injected at build time from the Cloudflare build environment. Never committed.
//
// BOTH are required. ADMIN_KEY is the token, and it is embedded in this page —
// so if Cloudflare Access is not actually protecting /admin/*, shipping it
// hands every guest's name and phone number to anyone who finds the URL.
// ACCESS_READY is the separate, explicit assertion that Access is on, and it
// exists because setting ADMIN_KEY is something you do to make the dashboard
// work, not a statement about who can reach it.
const adminKey = import.meta.env.ADMIN_KEY ?? '';
const accessReady = Boolean(import.meta.env.ACCESS_READY);
const enabled = Boolean(adminKey) && accessReady;

const endpoint =
  'https://script.google.com/macros/s/AKfycbzEqwax5hSzUdZhpo5e8Az7ZWeLC4CBkyKQZo4WBOL31ZABz5bOwVNiuCVAkv8mH2g/exec';

// Which links offer accommodation. Rows from any other link asking for a bed
// in their notes are flagged separately, since those get buried otherwise.
const config = {
  endpoint,
  adminKey,
  which,
  accomSlugs: invites.invites.filter((i) => i.accom).map((i) => i.slug),
  fnNames: {
    f1: invites.functions.f1.name,
    f2: invites.functions.f2.name,
    f3: invites.functions.f3.name,
  },
};
---

{
  !enabled ? (
    <div class="err">
      <p>
        <strong>This dashboard is disabled until the site is locked down.</strong>
      </p>
      <p>
        Intentional. This page embeds a token that can read every guest's name and
        phone number, so it ships empty until Cloudflare Access is confirmed to be
        protecting it. Set all three, then redeploy:
      </p>
      <ol>
        <li>
          Apps Script → Project Settings → Script Properties → add <code>ADMIN_KEY</code>
        </li>
        <li>
          Cloudflare → Worker → Settings → Build variables → add <code>ADMIN_KEY</code>
          with the same value
        </li>
        <li>
          Cloudflare Access protecting <code>/admin/*</code>, then a build variable
          <code>ACCESS_READY</code> set to any value
        </li>
      </ol>
    </div>
  ) : (
    <>
      <script type="application/json" id="report-config" set:html={JSON.stringify(config)} />
      <div id="report">
        <p class="muted" id="status">Loading…</p>
      </div>
    </>
  )
}

{
  enabled && (
    <script>
      import { current, headcount, declined, bedNights, kitchen, buried, repeats, num } from '../lib/report';

      const cfg = JSON.parse(document.getElementById('report-config')!.textContent!);
      const report = document.getElementById('report')!;

      const esc = (s: unknown) =>
        String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      const wa = (phone: string) => {
        const digits = String(phone).replace(/[^0-9]/g, '');
        return digits
          ? `<a href="https://wa.me/${digits}" target="_blank" rel="noopener">${esc(phone)}</a>`
          : esc(phone);
      };

      function table(headers: { label: string; num?: boolean }[], rows: string[][], empty: string) {
        if (!rows.length) return `<p class="empty">${empty}</p>`;
        return (
          '<div class="scroll"><table><thead><tr>' +
          headers.map((h) => `<th${h.num ? ' class="num"' : ''}>${esc(h.label)}</th>`).join('') +
          '</tr></thead><tbody>' +
          rows
            .map(
              (r) =>
                '<tr>' +
                r.map((c, i) => `<td${headers[i].num ? ' class="num"' : ''}>${c}</td>`).join('') +
                '</tr>'
            )
            .join('') +
          '</tbody></table></div>'
        );
      }

      function render(tabs: Record<string, any[]>) {
        const all = Object.keys(tabs).flatMap((tab) =>
          tabs[tab].map((r) => ({ ...r, _tab: tab }))
        );
        const live = current(all);
        const heads = headcount(all);
        const nights = bedNights(all);
        const { duplicates, resubmitted } = repeats(all);

        let html = '';

        html += '<h2>Headcount</h2><div class="cards">';
        for (const id of ['f1', 'f2', 'f3'] as const) {
          html += `<div class="card"><b>${heads[id]}</b><span>${esc(cfg.fnNames[id])}</span></div>`;
        }
        html += `<div class="card"><b>${live.length}</b><span>responses</span></div>`;
        html += `<div class="card"><b>${declined(all).length}</b><span>not coming</span></div>`;
        html += '</div>';

        html += '<h2>Bed-nights</h2><div class="cards">';
        for (const d of ['26', '27', '28'] as const) {
          html += `<div class="card"><b>${nights[d]}</b><span>night of ${d} Dec</span></div>`;
        }
        html +=
          '</div><p class="muted">People needing a bed. Rooms are paired manually by phone — this is not a room count.</p>';

        html += '<h2>Kitchen list</h2>';
        html += table(
          [{ label: 'Name' }, { label: 'Requirement' }],
          kitchen(all).map((r) => [esc(r.name), esc(r.dietary)]),
          'No dietary requirements submitted.'
        );

        html += '<h2>Possible accommodation requests <span class="flag">needs a look</span></h2>';
        html += table(
          [{ label: 'Name' }, { label: 'Phone' }, { label: 'Note' }],
          buried(all, cfg.accomSlugs).map((r) => [esc(r.name), wa(r.phone_e164), esc(r.notes)]),
          'None.'
        );

        html += '<h2>Duplicates</h2>';
        html += table(
          [{ label: 'Phone' }, { label: 'Names' }, { label: 'Live rows', num: true }],
          duplicates.map((p) => {
            const rows = all.filter((r) => r.phone_e164 === p);
            return [
              wa(p),
              esc(rows.map((r) => r.name).join(', ')),
              String(rows.filter((r) => r.superseded !== 'yes').length),
            ];
          }),
          'None — every number has exactly one current row.'
        );
        html += `<p class="muted">${resubmitted.length} number(s) resubmitted and superseded correctly.</p>`;

        html += '<h2>All current responses</h2>';
        html += table(
          [
            { label: 'Name' },
            { label: 'Phone' },
            { label: 'With' },
            { label: cfg.fnNames.f1, num: true },
            { label: cfg.fnNames.f2, num: true },
            { label: cfg.fnNames.f3, num: true },
            { label: 'Stay' },
            { label: 'Notes' },
          ],
          live.map((r) => [
            esc(r.name),
            wa(r.phone_e164),
            esc(r.additional_guests),
            String(num(r.count_f1)),
            String(num(r.count_f2)),
            String(num(r.count_f3)),
            r.accommodation === 'yes'
              ? esc(`${r.travellers} · ${String(r.nights).split('|').join(', ')}`)
              : '<span class="muted">—</span>',
            esc(r.notes),
          ]),
          'No responses yet.'
        );

        report.innerHTML = html;
      }

      async function load() {
        try {
          const res = await fetch(
            `${cfg.endpoint}?report=${encodeURIComponent(cfg.which)}&key=${encodeURIComponent(cfg.adminKey)}`,
            { mode: 'cors' }
          );
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || 'request rejected');
          // An out-of-date deployment ignores ?report= and answers with the
          // health response, which is ok:true but carries no rows.
          if (!data.tabs) {
            throw new Error(
              'The deployed Apps Script does not have the report endpoint yet. Paste the current apps-script/Code.gs, then Deploy → Manage deployments → Edit → New version.'
            );
          }
          render(data.tabs);
        } catch (err: any) {
          report.innerHTML =
            `<div class="err"><strong>Could not load the sheet.</strong><br>${esc(err?.message ?? err)}` +
            `<br><br>"unauthorised" means ADMIN_KEY differs between Apps Script and Cloudflare. ` +
            `"ADMIN_KEY not set" means it is missing from Apps Script → Project Settings → Script Properties.</div>`;
        }
      }

      load();
    </script>
  )
}

---
// Live mode. During the wedding days the invitation leads with what is
// happening now, or what is next, pinned above everything else.
//
// COMPUTED CLIENT-SIDE, ALWAYS IN IST. A static site's HTML is baked at build
// time, so a build-time switch would show whatever was true at the last deploy.
// And guests will be holding phones set to London, Dubai and California — the
// answer must be Gurgaon's clock regardless of the device.
//
// The state machine lives in src/lib/live.ts and is covered by
// scripts/test-live.mjs, because THIS CANNOT BE FIXED WHILE IT IS RUNNING.
// This file only renders.
//
// Append ?now=<ISO> to any invitation URL to fake the clock and check a state —
// e.g. ?now=2026-12-27T16:00. The value is read as IST.
interface Props {
  functions: {
    id: string;
    name: string;
    date: string;
    startTime?: string;
    ceremonies?: { name: string; startTime: string }[];
    venue: string;
    mapsUrl: string;
  }[];
  contact: { name: string; phone: string };
}

const { functions, contact } = Astro.props;

// Only this link's functions are passed, so live mode can never announce a
// function this guest was not invited to.
const events = functions.map((f) => ({
  name: f.name,
  date: f.date,
  venue: f.venue,
  mapsUrl: f.mapsUrl,
  // Each ceremony carries its own venue where it has one, so live mode can
  // point at the building the guest should actually be walking into.
  times: f.ceremonies?.length
    ? f.ceremonies.map((c: any) => ({
        label: c.name,
        at: c.startTime,
        venue: c.venue,
        mapsUrl: c.mapsUrl,
      }))
    : [{ label: '', at: f.startTime ?? '' }],
}));
---

<script
  type="application/json"
  id="live-config"
  set:html={JSON.stringify({ events, contact })}
/>

<div id="live" class="live" hidden></div>

<script>
  import { plan, stateAt, timeLine, dayLabel, whereNow, segments } from '../lib/live.ts';
  import { fakedNow } from '../lib/time.ts';

  const el = document.getElementById('live');
  const cfgEl = document.getElementById('live-config');

  if (el && cfgEl) {
    const { events, contact } = JSON.parse(cfgEl.textContent!);
    const now = fakedNow(new URLSearchParams(location.search).get('now')) ?? Date.now();
    const state = stateAt(plan(events), now);

    const esc = (s: unknown) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    // A time is never printed apart from its venue. Where a function runs across
    // two buildings, each ceremony gets its own row with its own pin; the one
    // happening now is marked. Printing both times over a single venue line is
    // what sent a reader to the wrong building.
    const where = (fn: any) => {
      const segs = segments(fn, now);
      if (segs.length < 2) {
        const w = whereNow(fn, now);
        return `<p class="live-venue">${esc(w.venue)}</p>`;
      }
      return (
        `<ul class="live-segs">` +
        segs
          .map(
            (s: any) =>
              `<li class="live-seg${s.active ? ' is-now' : ''}">` +
              `<span class="live-seg-when">${esc(s.label ? `${s.label} · ${s.at}` : s.at)}</span>` +
              `<span class="live-seg-where">${esc(s.venue)}</span>` +
              `<a class="live-seg-map" href="${esc(s.mapsUrl)}" target="_blank" rel="noopener noreferrer">` +
              `Directions<span class="sr-only"> to ${esc(s.venue)}</span></a>` +
              `</li>`
          )
          .join('') +
        `</ul>`
      );
    };

    // With per-ceremony rows the venue is already on each row, so the single
    // Get Directions button would be a second, ambiguous answer to the same
    // question. It stays only when there is one place to go.
    const actions = (fn: any) => {
      const one = segments(fn, now).length < 2;
      return (
        `<div class="live-actions">` +
        (one
          ? `<a class="live-btn" href="${esc(whereNow(fn, now).mapsUrl)}" target="_blank" rel="noopener noreferrer">Get Directions</a>`
          : '') +
        `<a class="live-btn quiet" href="tel:${esc(contact.phone.replace(/\s+/g, ''))}">Call ${esc(contact.name)}</a>` +
        `</div>`
      );
    };

    let html = '';

    if (state.kind === 'now') {
      // The single time line stays only for a one-ceremony function; where
      // there are several, where() prints them with their venues.
      const t = segments(state.fn, now).length < 2 ? timeLine(state.fn) : '';
      html =
        `<p class="live-label">Happening now</p>` +
        `<p class="live-name">${esc(state.fn.name)}</p>` +
        (t ? `<p class="live-time">${esc(t)}</p>` : '') +
        where(state.fn) +
        actions(state.fn);
    } else if (state.kind === 'next') {
      const many = segments(state.fn, now).length >= 2;
      const t = many ? '' : timeLine(state.fn);
      html =
        `<p class="live-label">Up next</p>` +
        `<p class="live-name">${esc(state.fn.name)}</p>` +
        `<p class="live-time">${esc(dayLabel(state.fn, now))}${t ? ' · ' + esc(t) : ''}</p>` +
        where(state.fn) +
        actions(state.fn);
    } else if (state.kind === 'after') {
      // Nowhere left to go, so no venue and no directions.
      html =
        `<p class="live-label">Thank you for celebrating with us</p>` +
        `<p class="live-after">It meant everything having you there.</p>`;
    }

    if (html) {
      el.innerHTML = html;
      el.hidden = false;
    }
  }
</script>

<style>
  .live {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    padding: var(--gap);
    margin: var(--gap) 0 0;
    text-align: left;
  }
  .live :global(.live-label) {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--gap-xs);
  }
  .live :global(.live-name) {
    font-family: var(--display);
    font-size: var(--t-lg);
    color: var(--ink);
    margin: 0;
    line-height: 1.15;
  }
  .live :global(.live-time) {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-base);
    color: var(--body);
    margin: var(--gap-xs) 0 0;
  }
  .live :global(.live-venue),
  .live :global(.live-after) {
    font-family: var(--sans);
    font-size: var(--t-base);
    line-height: 1.55;
    color: var(--body);
    margin: var(--gap-xs) 0 0;
  }
  .live :global(.live-segs) {
    list-style: none;
    margin: var(--gap-sm) 0 0;
    padding: 0;
  }
  .live :global(.live-seg) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-xs) var(--gap-sm);
    padding: var(--gap-xs) 0;
    border-bottom: 1px dotted var(--line);
  }
  .live :global(.live-seg:last-child) {
    border-bottom: 0;
  }
  .live :global(.live-seg-when) {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-base);
    color: var(--body);
  }
  /* The ceremony under way is the one a guest needs to act on. Weight and
     colour only — never a colour alone, since that is invisible to some
     readers and to anyone glancing at a phone in December sunlight. */
  .live :global(.live-seg.is-now .live-seg-when) {
    color: var(--ink);
  }
  .live :global(.live-seg.is-now .live-seg-when)::before {
    content: 'Now · ';
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .live :global(.live-seg-where) {
    font-family: var(--sans);
    font-size: var(--t-sm);
    color: var(--body);
    opacity: 0.85;
  }
  .live :global(.live-seg-map) {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-xs);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .live :global(.live-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin-top: var(--gap);
  }
  .live :global(.live-btn) {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-sm);
    text-decoration: none;
    padding: 0.7rem 1.1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--panel);
  }
  .live :global(.live-btn.quiet) {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }
</style>
